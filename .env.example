# ============================================================
# CHubbMan小幫手 環境變數範本 (.env.example)
# 使用方式：複製本檔為 .env 後填入你的值
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 產生新 secret（隨機）： npm run gen:secrets
# ============================================================

# ---------- Discord 應用程式憑證 ----------
# 取自 https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1533040341014417491
DISCORD_CLIENT_SECRET=

# ---------- 對外網址 ----------
# API 與網站的對外位址（部署到 VPS 時改為 https:// 網域）
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
# Discord Developer Portal → OAuth2 → 必須將此 URI 加入 Redirects
OAUTH_REDIRECT_URI=http://localhost:4000/api/oauth/callback

# ---------- 安全密鑰（務必更換，勿與範例相同）----------
# Session 加密密鑰（建議 ≥32 字元隨機字串）
SESSION_SECRET=
# Bot↔API 內部事件簽章密鑰（HMAC-SHA256，兩端必須一致）
HMAC_SECRET=

# ---------- 資料庫 / 快取 ----------
# MongoDB 連線字串（留空 = 記憶體模式，看板部分數據受限）
MONGODB_URI=mongodb://127.0.0.1:27017/chubbman
# Redis 連線字串（留空 = 不使用外部快取）
REDIS_URL=redis://127.0.0.1:6379/0
# 全域看板指標快取秒數
CACHE_TTL_SECONDS=30

# ---------- 功能開關 ----------
# 是否啟用插件上傳的 Smart File Scan 深度掃描
PLUGIN_SCAN_ENABLED=false

# ---------- Bot AutoMod 預設值 ----------
# 權杖桶容量（每成員每視窗可發訊息數）
AUTOMOD_TOKEN_CAPACITY=8
# 累積警告達標即自動禁言
AUTOMOD_WARN_THRESHOLD=3
# 防爆破偵測視窗（毫秒）
AUTOMOD_RAID_WINDOW_MS=60000
# 視窗內加入多少人判定為防爆破
AUTOMOD_RAID_THRESHOLD=10
