# ============================================================
# CHubbMan小幫手 環境變數範本 (.env.example)
# 使用方式：複製本檔為 .env 後填入你的值
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 產生新 secret（隨機）： npm run gen:secrets
# ============================================================

# ---------- 安全提醒（重要） ----------
# - 切勿把實際憑證（如 DISCORD_BOT_TOKEN、SESSION_SECRET、HMAC_SECRET、REDIS_URL）提交到 Git 或在公開對話貼出。
# - 若憑證已外洩，立即在對應平台（Discord 開發者後台 / Redis provider / Render 等）旋轉（重設）該憑證，並更新部署環境變數。
# - 本檔僅為範例，請在部署平台（如 Render）以 Environment / Secrets 介面填入實際值。

# ---------- Discord 應用程式憑證 ----------
# 取自 https://discord.com/developers/applications
# 注意：在平台上設為環境變數 (不要放到 repo)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1533040341014417491
DISCORD_CLIENT_SECRET=

# ---------- 對外網址 ----------
# API 與網站的對外位址（部署到 VPS 時改為 https:// 網域）
# Render 部署範例：
#   API_BASE_URL=https://color-ticket-bot.onrender.com
#   WEB_BASE_URL=https://color-ticket-bot.onrender.com
#   OAUTH_REDIRECT_URI=https://color-ticket-bot.onrender.com/api/oauth/callback
API_PORT=4000
API_BASE_URL=https://color-ticket-bot.onrender.com
WEB_BASE_URL=https://color-ticket-bot.onrender.com
# Discord Developer Portal → OAuth2 → 必須將此 URI 加入 Redirects
# 未設定時自動推導為 <API_BASE_URL>/api/oauth/callback
OAUTH_REDIRECT_URI=https://color-ticket-bot.onrender.com/api/oauth/callback

# ---------- 安全密鑰（務必更換，勿與範例相同）----------
# Session 加密密鑰（建議 ≥32 字元隨機字串）
SESSION_SECRET=
# Bot↔API 內部事件簽章密鑰（HMAC-SHA256，兩端必須一致）
HMAC_SECRET=

# ---------- 資料庫 / 快取 ----------
# MongoDB 連線字串（留空 = 記憶體模式，看板部分數據受限）
MONGODB_URI=mongodb://127.0.0.1:27017/chubbman
# Redis 連線字串（留空 = 不使用外部快取）
REDIS_URL=redis://127.0.0.1:6379/0
# 全域看板指標快取秒數
CACHE_TTL_SECONDS=30

# ---------- 功能開關 ----------
# 是否啟用插件上傳的 Smart File Scan 深度掃描
PLUGIN_SCAN_ENABLED=false

# ---------- Bot AutoMod 預設值 ----------
# 權杖桶容量（每成員每視窗可發訊息數）
AUTOMOD_TOKEN_CAPACITY=8
# 累積警告達標即自動禁言
AUTOMOD_WARN_THRESHOLD=3
# 防爆破偵測視窗（毫秒）
AUTOMOD_RAID_WINDOW_MS=60000
# 視窗內加入多少人判定為防爆破
AUTOMOD_RAID_THRESHOLD=10

# ============================================================
# 部署平台（Render）上的快速操作指引（手機也可操作）
# ============================================================
# 1) 登入 Render Dashboard (https://dashboard.render.com)
# 2) 選擇你的 Service（例如：Color-Ticket-Bot）
# 3) 點 Environment → Add Environment Variable
#    - Key: DISCORD_BOT_TOKEN, Value: <你的 Bot token>
#    - Key: SESSION_SECRET, Value: <長隨機字串>
#    - Key: REDIS_URL, Value: <你的 redis 連線字串>
#    - 其他變數依需填入
#    儲存後回到 Service 頁面。
# 4) Manual Deploy → Branch: main → Deploy（若有 Clear cache 選項，建議勾選以確保拉到最新檔案）
# 5) 觀察 Live Logs：等待以下成功訊息出現
#    - [cache] Redis 已連線
#    - [redis] connected for session store
#    - Bot 成功啟動（Discord library 的 Ready/Logged in 訊息）
# 6) 若出錯，將部署日誌貼到本對話，我會幫你分析（請遮罩任何敏感資料）

# ============================================================
# 手機版快速測試（部署成功後）
# ============================================================
# - 開啟你的網站（WEB_BASE_URL），登入並使用“管理伺服器”功能驗證 API
# - 在 Discord 裡確認 Bot 為 online，執行一個測試指令（如 /ping）確認回應
# - 若遇到 401 或 503，貼上瀏覽器 Network 的該 request 的 status/response 與後端日誌

# ============================================================
# 重要：若你已在公開處貼出 token（或其他憑證），務必先在對應服務旋轉該憑證，
# 並立刻把新值更新到 Render 環境變數，然後重新部署。
# ============================================================
